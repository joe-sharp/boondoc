#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "net/http"

def ask(question, default = nil)
  print default ? "#{question} [#{default}]: " : "#{question}: "
  answer = $stdin.gets.to_s.strip
  answer.empty? ? default : answer
end

def run(*cmd)
  puts "$ #{cmd.join(" ")}"
  system(*cmd) || abort("Failed: #{cmd.join(" ")}")
end

# Compact index lists every published version of the gem as the first word of each line.
def published?(host, version)
  response = Net::HTTP.get_response(URI("#{host}/info/boondoc"))
  case response
  when Net::HTTPSuccess then response.body.each_line.any? { |line| line.split(" ", 2).first == version }
  when Net::HTTPNotFound then false
  else abort "Could not check #{host} for boondoc #{version}: #{response.code}"
  end
end

abort "GEM_HOST_API_KEY is not set" if ENV["GEM_HOST_API_KEY"].to_s.empty?

run("git", "checkout", "main")
run("git", "pull", "--ff-only", "origin", "main")
abort "main does not match origin/main" unless `git rev-parse main`.strip == `git rev-parse origin/main`.strip
abort "Working tree is not clean" unless `git status --porcelain`.empty?

require_relative "../lib/boondoc/version"

changelog = File.read("CHANGELOG.md", encoding: "UTF-8")
latest = changelog[/^## \[(\d+\.\d+\.\d+)\]/, 1] or abort "No version in CHANGELOG.md"
description = ask("Release description") or abort "A description is required"
tag = ask("Release", "v#{latest}")

abort "#{tag} is not vX.Y.Z" unless tag.match?(/\Av\d+\.\d+\.\d+\z/)
abort "#{tag} does not match Boondoc::VERSION (#{Boondoc::VERSION})" unless tag == "v#{Boondoc::VERSION}"

tag_exists = system("git", "rev-parse", "-q", "--verify", "refs/tags/#{tag}", out: File::NULL)
tag_commit = `git rev-parse "#{tag}^{commit}"`.strip if tag_exists
abort "#{tag} already exists but does not point at HEAD" if tag_exists && tag_commit != `git rev-parse HEAD`.strip

puts "\nTag #{tag}: #{description}"
exit unless ask("Tag, push, build and publish? (y/N)").to_s.downcase.start_with?("y")

if tag_exists
  puts "#{tag} already exists at HEAD; not creating it again"
else
  run "git", "tag", "-a", tag, "-m", description
end
# Pushing a tag that the remote already has at the same commit is a no-op.
run "git", "push", "origin", tag

gem_file = "pkg/boondoc-#{Boondoc::VERSION}.gem"
FileUtils.mkdir_p("pkg")
run("gem", "build", "boondoc.gemspec", "--output", gem_file)

coop = "https://gem.coop/@joe-sharp"
if published?(coop, Boondoc::VERSION)
  puts "boondoc #{Boondoc::VERSION} is already on #{coop}; skipping"
else
  run("gem", "push", "--host", coop, gem_file)
end

if published?(Gem.host, Boondoc::VERSION)
  puts "boondoc #{Boondoc::VERSION} is already on #{Gem.host}; skipping"
else
  run("gem", "push", gem_file)
end
