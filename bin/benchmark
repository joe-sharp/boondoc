#!/usr/bin/env ruby
# frozen_string_literal: true

# Times boondoc documenting Ruby code from scratch. Results go to stdout; with --verbose,
# progress goes to stderr: a key to the marks, then a mark as each timed run starts.
#
#   bin/benchmark                                  # boondoc on this project
#   bin/benchmark --boondoc-only                   # time boondoc alone, without --yard-macros
#   bin/benchmark --compare                        # also YARD, YARD with yard-markdown, and RDoc on this project
#   bin/benchmark ~/dev/some_project               # boondoc on another repository or gem directory
#   bin/benchmark --for-docs                     # the performance table, for this project and the installed
#                                                  # yard, rdoc and rubocop gems
#   bin/benchmark --for-docs ~/dev/some_project  # the performance table, for any directories
#   bin/benchmark --verbose                        # also show progress while it runs
#   RUNS=3 bin/benchmark
#
# Every Ruby file of the directory is copied to a temporary directory first, and every tool
# documents that same set of files, so nothing is written to the projects themselves. For a
# git repository that is the tracked and new files outside hidden directories; for an installed
# gem it is the whole gem directory. --compare and --for-docs need the yard, yard-markdown and
# rdoc gems installed.
#
# Each tool first runs once without timing. That run must succeed and write its output, or the
# benchmark stops and shows the tool's last error lines. Then the timed runs go round by round:
# every round runs each tool once, in a different order from the round before, so a change in
# the machine's speed during the benchmark affects all tools alike. The median of the runs is
# reported, with the spread: how far the furthest run was from the median.
#
# A run that takes longer than 10 minutes is killed, and its tool is reported as a timeout
# instead of a time.

require "fileutils"
require "open3"
require "optparse"
require "timeout"
require "tmpdir"
require_relative "../lib/boondoc/version"

ROOT = File.expand_path("..", __dir__)
RUNS = Integer(ENV.fetch("RUNS", 11))
abort "RUNS must be at least 1" unless RUNS.positive?

RUN_TIMEOUT = 600 # seconds; a tool whose run takes longer is killed and reported as a timeout
TIMED_OUT = :timeout
OUTPUT = "out" # where each tool writes its docs, relative to the copied files
RUBY = RbConfig.ruby
RUBY_FILES = "**/*.rb"
BOONDOC = [RUBY,
           "-I#{File.join(ROOT, "lib")}",
           File.join(ROOT, "exe", "boondoc"),
           "--quiet",
           "--skip-readme",
           "-o",
           OUTPUT].freeze

# Progress goes to stderr, and only with --verbose.
def log(message, newline: true)
  return unless @verbose

  newline ? warn(message) : $stderr.print(message)
end

# Two-character marks printed as each tool starts its timed run, so the rotation is visible while
# it goes. A second character of + or - marks a variant of the first character's tool.
TOOL_MARKS = {
  "boondoc" => "b.", "boondoc `--yard-macros`" => "b+", "YARD" => "y.",
  "YARD + yard-markdown" => "y+", "YARD (parse only)" => "y-", "RDoc" => "r."
}.freeze

def log_key(tools)
  log "Key: #{tools.keys.map { |label| "#{TOOL_MARKS.fetch(label)} #{label}" }.join(", ")}"
end

def boondoc_tools
  { "boondoc" => [*BOONDOC, RUBY_FILES], "boondoc `--yard-macros`" => [*BOONDOC, "--yard-macros", RUBY_FILES] }
end

def comparison_tools
  Gem::Specification.find_by_name("yard-markdown") # the plugin is found by yard, but check it early
  yard = [RUBY,
          Gem.bin_path("yard", "yard"),
          "doc",
          "--quiet",
          "--no-save",
          "--no-cache",
          "--no-stats",
          "--no-yardopts"]
  {
    "YARD" => [*yard, "-o", OUTPUT, RUBY_FILES],
    "YARD + yard-markdown" => [*yard, "--plugin", "markdown", "--format=markdown", "-o", OUTPUT, RUBY_FILES],
    "YARD (parse only)" => [*yard, "-n", RUBY_FILES],
    "RDoc" => [RUBY, Gem.bin_path("rdoc", "rdoc"), "--quiet", "-o", OUTPUT, "."]
  }
rescue Gem::LoadError => e
  abort "YARD, yard-markdown and RDoc must be installed (#{e.message})"
end

# Seconds the command took in dir, and whether it succeeded. The seconds are nil when the
# command outlived RUN_TIMEOUT (it is killed). Output is cleared first, outside the timing.
# Standard error goes to err, which defaults to nowhere.
def run_once(command, dir, err = File::NULL)
  clear_output(dir)
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  pid = Process.spawn(*command, chdir: dir, out: File::NULL, err: err)
  status = wait_for(pid)
  return [nil, false] unless status

  [Process.clock_gettime(Process::CLOCK_MONOTONIC) - started, status.success?]
end

def clear_output(dir)
  FileUtils.rm_rf([File.join(dir, OUTPUT), File.join(dir, ".yardoc")])
end

# The exit status of the process, or nil after killing it when it outlives RUN_TIMEOUT.
def wait_for(pid)
  Timeout.timeout(RUN_TIMEOUT) { Process.wait2(pid).last }
rescue Timeout::Error
  Process.kill("KILL", pid)
  Process.wait(pid)
  nil
end

# Runs each tool once, untimed. Stops when one fails or writes nothing to OUTPUT. Returns the
# labels of the tools whose check run outlived RUN_TIMEOUT, so they are not timed at all.
def check_tools(tools, dir)
  tools.keys.select { |label| check_tool(label, tools[label], dir) == TIMED_OUT }
end

def check_tool(label, command, dir)
  Dir.mktmpdir("boondoc-check") do |tmp|
    err = File.join(tmp, "stderr")
    elapsed, ok = run_once(command, dir, err)
    return TIMED_OUT if elapsed.nil?

    abort "#{label} failed:\n#{File.read(err).lines.last(10).join}" unless ok
    abort "#{label} wrote nothing to #{OUTPUT}" if wrote_nothing?(command, dir)
  end
  nil
end

def wrote_nothing?(command, dir)
  return false unless command.include?(OUTPUT)

  output = File.join(dir, OUTPUT)
  !File.directory?(output) || Dir.empty?(output)
end

# The sorted run times of every tool, or TIMED_OUT for a tool in timed_out or one that outlives
# RUN_TIMEOUT. Each round runs every live tool once, in a different order from the round before,
# so a slowdown during the benchmark is spread across the tools.
def time_tools(tools, dir, timed_out)
  times = Hash.new { |hash, label| hash[label] = [] }
  RUNS.times { |round| time_round(tools, dir, timed_out, round, times) }
  tools.keys.to_h { |label| [label, timed_out.include?(label) ? TIMED_OUT : times[label].sort] }
end

def time_round(tools, dir, timed_out, round, times)
  live = tools.keys - timed_out
  return if live.empty?

  live.rotate(round % live.size).each do |label|
    log "#{TOOL_MARKS.fetch(label)} ", newline: false
    elapsed = time_run(tools[label], dir)
    elapsed ? times[label] << elapsed : timed_out << label
  end
  log ""
end

# Seconds for one timed run, or nil when it timed out. Aborts when the command fails.
def time_run(command, dir)
  elapsed, ok = run_once(command, dir)
  abort "failed: #{command.join(" ")}" if elapsed && !ok
  elapsed
end

def median(times)
  middle = times.size / 2
  times.size.odd? ? times[middle] : (times[middle - 1] + times[middle]) / 2.0
end

# How far the furthest run was from the median, as a percentage of the median.
def spread(times)
  middle = median(times)
  100 * times.map { |time| (time - middle).abs }.max / middle
end

def timing_text(times, format_string)
  (times == TIMED_OUT) ? "timeout" : format(format_string, median(times))
end

def with_commas(number)
  number.to_s.reverse.scan(/\d{1,3}/).join(",").reverse
end

# The Ruby files of a directory, relative to it: the tracked and new files of a git repository
# (so ignored paths such as vendor/ are left out), or every file of an installed gem. Files in
# hidden directories such as .github are left out too: boondoc, YARD and RDoc all skip them.
def ruby_files(source)
  files = if File.directory?(File.join(source, ".git"))
    stdout, status = Open3.capture2(
      "git",
      "-C",
      source,
      "ls-files",
      "-z",
      "--cached",
      "--others",
      "--exclude-standard",
      "--",
      "*.rb"
    )
    abort "git ls-files failed in #{source}" unless status.success?

    stdout.split("\0")
  else
    Dir.glob(RUBY_FILES, base: source)
  end
  files.reject do |file|
    hidden = file.split("/").any? { |part| part.start_with?(".") }
    hidden || File.symlink?(File.join(source, file)) || !File.file?(File.join(source, file))
  end.sort
end

# Copies the Ruby files of source to a temporary directory and times every tool on them.
def measure(source, tools)
  files = ruby_files(source)
  abort "no Ruby files in #{source}" if files.empty?

  Dir.mktmpdir("boondoc-benchmark") do |dir|
    copy_files(source, files, dir)
    lines = files.sum { |file| File.foreach(File.join(dir, file)).count }
    timed_out = check_tools(tools, dir)
    timings = time_tools(tools, dir, timed_out)
    { files: files.size, lines: lines, timings: timings }
  end
end

def copy_files(source, files, dir)
  files.each do |file|
    FileUtils.mkdir_p(File.join(dir, File.dirname(file)))
    FileUtils.cp(File.join(source, file), File.join(dir, file))
  end
end

def versions
  names = %w[yard yard-markdown rdoc rubocop prism]
  tools = ["boondoc #{Boondoc::VERSION} (#{codebase_label(ROOT)})",
           *names.map { |name| "#{name} #{Gem::Specification.find_by_name(name).version}" }]
  "#{RUBY_DESCRIPTION}; #{tools.join(", ")}"
end

# The directory's name, with the commit when it is a git repository, so a row says which code it timed.
# A "-dirty" suffix means .rb files were changed or added since that commit, and they were timed too.
def codebase_label(dir)
  name = File.basename(File.expand_path(dir))
  return name unless File.directory?(File.join(dir, ".git"))

  sha, status = Open3.capture2(
    "git",
    "-C",
    dir,
    "rev-parse",
    "--short",
    "HEAD"
  )
  return name unless status.success?

  changed, = Open3.capture2(
    "git",
    "-C",
    dir,
    "status",
    "--porcelain",
    "--",
    "*.rb"
  )
  label = "#{name} #{sha.strip}"
  changed.strip.empty? ? label : "#{label}-dirty"
end

def docs_codebases(dirs)
  return dirs.to_h { |dir| [codebase_label(dir), File.expand_path(dir)] } unless dirs.empty?

  codebases = { "boondoc" => ROOT }
  %w[yard rdoc rubocop].each do |name|
    spec = Gem::Specification.find_by_name(name)
    codebases["#{name} #{spec.version}"] = spec.gem_dir
  end
  codebases
end

def project_summary(compare, source, boondoc_only: false)
  tools = boondoc_tools.merge(compare ? comparison_tools : {})
  tools = tools.slice("boondoc") if boondoc_only
  log_key(tools)
  result = measure(source, tools)
  puts "#{codebase_label(source)}: #{result[:files]} Ruby files, #{with_commas(result[:lines])} lines, " \
       "#{RUNS} runs each (#{RUBY_DESCRIPTION})"
  result[:timings].each { |label, times| puts timing_line(label, times) }
end

def timing_line(label, times)
  return format("  %-26s timeout (a run took over %d minutes)", label, RUN_TIMEOUT / 60) if times == TIMED_OUT

  # rubocop:disable-next Layout/MultilineMethodArgumentLineBreaks
  format(
    "  %-26s median %.2fs  min %.2fs  max %.2fs  ±%d%%",
    label, median(times), times.first, times.last, spread(times).round
  )
end

def docs_header(tools)
  header = ["Codebase", "Ruby files", "Lines", *tools.keys]
  puts "Seconds, median of #{RUNS} runs; timeout if a run takes over #{RUN_TIMEOUT / 60} minutes. #{versions}", ""
  puts "| #{header.join(" | ")} |"
  puts "| --- |#{" ---: |" * (header.size - 1)}"
end

def docs_row(name, result)
  timings = result[:timings].values.map { |times| timing_text(times, "%.2f") }
  "| #{[name, result[:files], with_commas(result[:lines]), *timings].join(" | ")} |"
end

def docs_table(dirs)
  tools = boondoc_tools.merge(comparison_tools)
  codebases = docs_codebases(dirs)
  log "Timing #{codebases.size} codebases, #{RUNS} runs each"
  log_key(tools)
  docs_header(tools)
  widest = codebases.filter_map { |name, source| docs_codebase(name, source, tools) }.max_by(&:first)
  puts "", "Each run was within ±#{widest.first}% of its tool's median (widest: #{widest.last})." if widest
end

# Prints the codebase's row, and returns [percent, "tool on codebase"] for its run furthest from the median.
def docs_codebase(name, source, tools)
  log name
  result = measure(source, tools)
  puts docs_row(name, result)
  result[:timings].reject { |_, times| times == TIMED_OUT }
    .map { |label, times| [spread(times).round, "#{label} on #{name}"] }.max_by(&:first)
end

options = { compare: false, for_docs: false, verbose: false, boondoc_only: false }
OptionParser.new do |opts|
  opts.banner = "usage: bin/benchmark [DIR] [--compare] | bin/benchmark --for-docs [DIR ...]"
  opts.on("--compare", "Also time YARD, YARD with yard-markdown, and RDoc on the directory") do
    options[:compare] = true
  end
  opts.on("--boondoc-only", "Time only boondoc, without --yard-macros") { options[:boondoc_only] = true }
  opts.on("--for-docs", "Print the performance table (implies --compare)") { options[:for_docs] = true }
  opts.on("--verbose", "Print progress to stderr: a key, then a mark per timed run") { options[:verbose] = true }
end.parse!
abort "pass one DIR, or several with --for-docs" if ARGV.size > 1 && !options[:for_docs]
if options[:boondoc_only] && (options[:compare] || options[:for_docs])
  abort "--boondoc-only cannot be combined with --compare or --for-docs"
end
@verbose = options[:verbose]

# Bundler's environment would make every child process load the bundle.
run = lambda do
  if options[:for_docs]
    docs_table(ARGV)
  else
    project_summary(options[:compare], ARGV.first || ROOT, boondoc_only: options[:boondoc_only])
  end
end
defined?(Bundler) ? Bundler.with_unbundled_env(&run) : run.call
