# frozen_string_literal: true

# Appraisals only run RSpec. RuboCop and irb limit prism (rubocop-ast ~> 1.7,
# rdoc and rbs >= 1.6), so they are dropped here and the lint job keeps the root Gemfile.
# appraisal2 and appraisal2-rubocop only generate these gemfiles, so they are dropped too.
# remove_gem only finds top-level gems and returns nil otherwise, so those in the
# development group are removed from there instead.
REMOVED_GEMS = %w[appraisal2 appraisal2-rubocop irb rubocop sharp_style_rubocop].freeze

customize_gemfiles do
  {
    heading: <<~HEADING
      frozen_string_literal: true

      This file was generated by Appraisal2
    HEADING
  }
end

plugin("appraisal2-rubocop", require: "appraisal2/rubocop")

# The lowest versions boondoc supports, all of which still work on Ruby 4.0.
appraise "oldest" do
  REMOVED_GEMS.each { |name| remove_gem(name) || group(:development) { remove_gem(name) } }
  gem "prism", "1.0.0"
  gem "thor", "1.2.0"
  group :yard do
    gem "yard", "0.9.39"
  end
end

appraise "prism-1" do
  REMOVED_GEMS.each { |name| remove_gem(name) || group(:development) { remove_gem(name) } }
  gem "prism", "~> 1.9"
end

appraise "prism-2" do
  REMOVED_GEMS.each { |name| remove_gem(name) || group(:development) { remove_gem(name) } }
  gem "prism", "~> 2.0"
end
